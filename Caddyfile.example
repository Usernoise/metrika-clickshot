metrika.clickshot.ru {
    root * /var/www/metrika.clickshot.ru/public

    # Отдаёт персонализированный загрузчик по прежнему URL /counter.js?id=SITE_ID.
    # При включённом Slide Cookie он содержит баннер до кода метрики.
    @counter path /counter.js
    uri @counter replace /counter.js /api/loader.php

    php_fastcgi unix//run/php/php8.3-fpm.sock
    file_server

    @health path /health
    rewrite @health /health.php

    handle_errors {
        respond "Ошибка сервера" 500
    }

    # Не включайте access log для этого хоста,
    # если не хотите сохранять IP-адреса посетителей.
}
